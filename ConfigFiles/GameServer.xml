<?xml version="1.0"?>
<GameServer>
  <!-- The Earth (ground) server's port. Run a second copy with -instance=space for Space: it listens on
       Port + 1 (42011). Without the argument (or with -instance=ground) the server runs Earth. -->
  <Port>42010</Port>

  <!-- Only log in characters the Lobby handed over (session key from the login reply). Turn off only for testing. -->
  <CheckSessionKey>true</CheckSessionKey>

  <!-- How far away other players are visible, in position units. 0 uses what the client asks for (8000 on foot). -->
  <ViewDistance>0</ViewDistance>

  <!-- Chance in percent that a destroyed vehicle (a player's or an NPC's) leaves a wreck; otherwise nothing is left. -->
  <WreckChance>70</WreckChance>

  <!-- Skills, in tenths (1000 = 100.0). All skills together stop at SkillTotalCap (the Java server's 800.0;
       0 = no cap); past it a gain takes the same from skills whose arrow in the Status Setting window points down.
       Strength, spirit and luck rise by play up to StatusCap. SkillGainRate scales every growth chance (percent). -->
  <SkillTotalCap>8000</SkillTotalCap>
  <StatusCap>170</StatusCap>
  <SkillGainRate>100</SkillGainRate>

  <!-- Criminals: attacking a player of your own faction (or their empty vehicle) adds crime points; the client
       lowers them by one every 3 minutes online (30 s for the last). At CrimeExileCount points (0 = never) the
       player is exiled: disconnected and moved to the exile point of their side ("x, y, z"; empty = stays put). -->
  <CrimeExileCount>30</CrimeExileCount>
  <CrimeExileEarth></CrimeExileEarth>
  <CrimeExileSpace></CrimeExileSpace>

  <!-- Battle towns Richmond and Newman (Earth server only): peace for OccupationPeaceMinutes, then the town is open
       to attack until the other faction hits one of its laser communication towers, which starts a war of
       OccupationWarMinutes. Taking all five ICFs wins the town; otherwise the owner keeps it.
       OccupationMedals: medal points for joining a war, per ICF captured, and for the winners who took part. -->
  <OccupationEnabled>true</OccupationEnabled>
  <OccupationWarMinutes>60</OccupationWarMinutes>
  <OccupationPeaceMinutes>180</OccupationPeaceMinutes>
  <OccupationMedals>1, 5, 10</OccupationMedals>

  <!-- Seconds between position saves while a player is online (also saved on logout). -->
  <SaveInterval>60</SaveInterval>

  <!-- Hostile NPCs attack pilots of the other faction who come this close (position units).
       0 = they only fire back when attacked, like on the official server. -->
  <NpcAggroRange>1500</NpcAggroRange>

  <!-- Where the client reconnects after a shuttle flight: the other side's server (Earth: Port, Space:
       Port + 1) at this address as the client sees it (like GameServerIP in LobbyServer.xml). -->
  <TransferHost>127.0.0.1</TransferHost>

  <!-- MySQL database shared with the Lobby server (DB/SQL/accounts.sql, DB/SQL/characters.sql). -->
  <Database>
    <Host>127.0.0.1</Host>
    <Port>3306</Port>
    <Name>titans-server</Name>
    <User>root</User>
    <Password>titans</Password>
  </Database>

  <!-- 帐号服务器域名或IP -->
  <AccountHost>127.0.0.1</AccountHost>
  
  <!-- 帐号服务器端口 -->
  <AccountPort>42020</AccountPort>

  <!-- 帐号服务器内部通讯验证密码 -->
  <AccountPassword>titans_account</AccountPassword>

  <!-- 聊天服务器域名或IP -->
  <ChatHost>127.0.0.1</ChatHost>
  
  <!-- 聊天服务器端口 -->
  <ChatPort>10241</ChatPort>

  <!-- CMS server game link password, must match CMSServer.xml GameLinkPassword (GM commands like #tele and #shutdown). Empty turns the link off. -->
  <ChatPassword>titans_chat</ChatPassword>

  <!-- 人物服务器域名或IP -->
  <CharacterHost>127.0.0.1</CharacterHost>
  
  <!-- 人物服务器端口 -->
  <CharacterPort>42021</CharacterPort>

  <!-- 人物服务器内部通讯验证密码 -->
  <CharacterPassword>titans_character</CharacterPassword>
  
  <!-- Specify whether to enable the server to dynamically compile packet's as scripts. true/false -->
  <Scripted-Packets-Enabled>false</Scripted-Packets-Enabled>

  <!-- 
            日志等级：（加法）
            Info = 1,
            Warning = 2,
            Error = 4,
            SQL = 8,
            Debug = 16       
  -->
  <LogLevel>31</LogLevel>
  
 </GameServer>